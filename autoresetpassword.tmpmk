// ==UserScript==
// @name         vnEdu auto reset password
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  Rà số thứ tự, copy dữ liệu theo vùng, click theo toạ độ, ghi vào bảng 2 cột (A/B)
// @match        *://*/*
// @noframes
// @run-at       document-idle
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_setClipboard
// ==/UserScript==

(function () {
    'use strict';

    /* ===================== CẤU HÌNH ===================== */
    const zone2 = [[0, 80], [35, 80], [0, 600], [35, 600]];       // vùng số thứ tự
    const zone3 = [[30, 80], [165, 80], [30, 600], [165, 600]];   // vùng dữ liệu (I)
    const zone7 = [[520, 280], [1020, 280], [520, 420], [1020, 420]]; // vùng nội dung cần copy
    const P4 = [620, 65];
    const P5 = [720, 380];
    const P6 = [750, 380];

    const Y_TOLERANCE = 20;     // ± px theo trục y khi lấy dữ liệu ở vùng 3
    const DELAY = 600;          // ms chờ giữa các thao tác
    const DELAY_AFTER_P5 = 1200;// ms chờ nội dung vùng 7 hiện ra
    const FIND_RETRIES = 4;     // số lần thử tìm số n trước khi dừng
    const STORE_KEY = 'tm_auto_collector_v1';

    /* ===================== TRẠNG THÁI ===================== */
    const saved = GM_getValue(STORE_KEY, null) || {};
    const state = {
        n: saved.n || 1,
        data: saved.data || [],   // [{a, b}]
        running: false
    };
    let runToken = 0;

    const save = () => GM_setValue(STORE_KEY, { n: state.n, data: state.data });

    /* ===================== TIỆN ÍCH ===================== */
    const sleep = ms => new Promise(r => setTimeout(r, ms));
    const bbox = z => ({
        x1: Math.min(...z.map(p => p[0])), x2: Math.max(...z.map(p => p[0])),
        y1: Math.min(...z.map(p => p[1])), y2: Math.max(...z.map(p => p[1]))
    });
    const B2 = bbox(zone2), B3 = bbox(zone3), B7 = bbox(zone7);
    const inBox = (b, x, y) => x >= b.x1 && x <= b.x2 && y >= b.y1 && y <= b.y2;
    const isUI = el => el && el.closest && el.closest('[data-tm-ui]');

    // Phần tử `el` có đang nằm trên cùng (không bị lớp khác che) tại điểm (x, y) không?
    function isOnTop(el, x, y) {
        const top = document.elementsFromPoint(x, y).find(e => !isUI(e));
        if (!top) return false;
        return top === el || el.contains(top) || top.contains(el);
    }

    // Lấy mọi text node có tâm nằm trong vùng b
    function textBoxes(b) {
        const out = [];
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
        const range = document.createRange();
        let node;
        while ((node = walker.nextNode())) {
            const txt = node.textContent.trim();
            if (!txt) continue;
            const p = node.parentElement;
            if (!p || isUI(p) || /^(SCRIPT|STYLE|NOSCRIPT)$/.test(p.tagName)) continue;
            range.selectNodeContents(node);
            for (const r of range.getClientRects()) {
                if (r.width <= 0 || r.height <= 0) continue;
                const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
                if (!inBox(b, cx, cy)) continue;
                if (!isOnTop(p, cx, cy)) continue;   // bị lớp khác che → bỏ qua
                out.push({ text: txt, cx, cy });
                break;
            }
        }
        return out;
    }

    // Tìm số thứ tự n trong vùng 2
    function findNumber(n) {
        const hits = textBoxes(B2).filter(t => t.text === String(n));
        hits.sort((a, b) => a.cy - b.cy);
        return hits[0] || null;
    }

    // Đọc dữ liệu vùng 3 quanh trục y
    function readRow(y) {
        return textBoxes(B3)
            .filter(t => Math.abs(t.cy - y) <= Y_TOLERANCE)
            .sort((a, b) => a.cx - b.cx)
            .map(t => t.text).join(' ');
    }

    // Đọc toàn bộ nội dung vùng 7
    function readZone7() {
        const items = textBoxes(B7).sort((a, b) => a.cy - b.cy || a.cx - b.cx);
        const lines = [];
        for (const it of items) {
            const last = lines[lines.length - 1];
            if (last && Math.abs(last.cy - it.cy) < 8) last.parts.push(it.text);
            else lines.push({ cy: it.cy, parts: [it.text] });
        }
        return extractResult(lines.map(l => l.parts.join(' ')).join('\n'));
    }

    // Lấy phần nằm sau "là: " và trước " OK" (khoảng trắng/xuống dòng rồi OK)
    function extractResult(raw) {
        const text = raw.normalize('NFC');
        const m = text.match(/là:\s*([\s\S]*?)\s+OK(?![A-Za-z0-9])/);
        return m ? m[1].trim() : raw;   // không khớp mẫu → giữ nguyên nội dung gốc
    }

    function clickAt(x, y) {
        const el = document.elementsFromPoint(x, y).find(e => !isUI(e));
        if (!el) return false;
        // Không truyền `view` vì trong sandbox Tampermonkey `window` là proxy, không hợp lệ cho UIEventInit
        const o = { bubbles: true, cancelable: true, composed: true, clientX: x, clientY: y,
                    screenX: x, screenY: y, button: 0, buttons: 1, pointerId: 1, pointerType: 'mouse', isPrimary: true };
        el.dispatchEvent(new PointerEvent('pointerdown', o));
        el.dispatchEvent(new MouseEvent('mousedown', o));
        if (el.focus) try { el.focus({ preventScroll: true }); } catch (e) {}
        el.dispatchEvent(new PointerEvent('pointerup', o));
        el.dispatchEvent(new MouseEvent('mouseup', o));
        el.dispatchEvent(new MouseEvent('click', o));
        return true;
    }

    function pressDown() {
        const target = document.activeElement || document.body;
        const o = { key: 'ArrowDown', code: 'ArrowDown', keyCode: 40, which: 40, bubbles: true, cancelable: true };
        target.dispatchEvent(new KeyboardEvent('keydown', o));
        target.dispatchEvent(new KeyboardEvent('keyup', o));
    }

    /* ===================== UI ===================== */
    const css = `
    [data-tm-ui]{font:12px/1.35 Arial,sans-serif;color:#222;box-sizing:border-box}
    #tm-panel{position:fixed;top:8px;right:8px;z-index:2147483647;background:#fff;border:1px solid #888;
      border-radius:6px;padding:6px;display:flex;gap:4px;align-items:center;box-shadow:0 2px 8px #0004}
    #tm-panel button{cursor:pointer;border:1px solid #666;border-radius:4px;padding:3px 8px;background:#eee}
    #tm-play{background:#c8f7c5!important}#tm-pause{background:#ffd9d9!important}
    #tm-status{margin-left:4px;max-width:170px}
    #tm-layer{position:fixed;top:54px;right:8px;width:200px;height:600px;z-index:2147483646;background:#fff;
      border:1px solid #888;border-radius:6px;overflow:auto;box-shadow:0 2px 8px #0004}
    #tm-layer table{border-collapse:collapse;width:100%;table-layout:fixed}
    #tm-layer th{position:sticky;top:0;background:#f0f0f0;border:1px solid #bbb;padding:2px}
    #tm-layer td{border:1px solid #ccc;padding:2px 3px;vertical-align:top;word-break:break-word;
      white-space:pre-wrap;max-height:80px;overflow:hidden}
    #tm-layer td.i{width:22px;text-align:center;color:#888}`;
    const style = document.createElement('style');
    style.textContent = css;
    document.head.appendChild(style);

    const panel = document.createElement('div');
    panel.id = 'tm-panel';
    panel.setAttribute('data-tm-ui', '');
    panel.innerHTML = `
      <button id="tm-play">▶ Play</button>
      <button id="tm-pause">⏸ Pause</button>
      <button id="tm-copy" title="Copy bảng (TSV)">Copy</button>
      <button id="tm-reset" title="Xoá dữ liệu, n=1">Reset</button>
      <span id="tm-status"></span>`;
    document.body.appendChild(panel);

    const layer = document.createElement('div');
    layer.id = 'tm-layer';
    layer.setAttribute('data-tm-ui', '');
    document.body.appendChild(layer);

    const $ = id => panel.querySelector(id);
    const setStatus = s => { $('#tm-status').textContent = s; };

    function render() {
        const rows = state.data.map((r, k) =>
            `<tr><td class="i">${k + 1}</td><td>${esc(r.a)}</td><td>${esc(r.b)}</td></tr>`).join('');
        layer.innerHTML = `<table><tr><th style="width:22px">#</th><th>A</th><th>B</th></tr>${rows}</table>`;
        layer.scrollTop = layer.scrollHeight;
    }
    const esc = s => String(s).replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));

    /* ===================== VÒNG LẶP CHÍNH ===================== */
    class Stopped extends Error {}
    async function wait(ms, token) {
        await sleep(ms);
        if (token !== runToken || !state.running) throw new Stopped();
    }

    async function cycle(token) {
        // 1. tìm số n trong vùng 2
        let hit = null;
        for (let t = 0; t < FIND_RETRIES && !hit; t++) {
            hit = findNumber(state.n);
            if (!hit) await wait(500, token);
        }
        if (!hit) { setStatus(`Không thấy số ${state.n} → dừng`); stop(); return; }

        const p0 = [hit.cx, hit.cy];
        setStatus(`n=${state.n} | hàng ${state.data.length + 1}`);

        // 2. copy dữ liệu vùng 3 (y ± 20) → cột A hàng i
        const row = { a: readRow(hit.cy), b: '' };
        state.data.push(row);
        render(); save();

        // 3. click n → click P4 → click P5
        clickAt(p0[0], p0[1]);   await wait(DELAY, token);
        clickAt(P4[0], P4[1]);   await wait(DELAY, token);
        clickAt(P5[0], P5[1]);   await wait(DELAY_AFTER_P5, token);

        // 4. đọc vùng 7 → cột B hàng i, click P6
        row.b = readZone7();
        render(); save();
        clickAt(P6[0], P6[1]);   await wait(DELAY, token);

        // 5. hết chu kỳ: click lại điểm đầu → phím Down → n++
        clickAt(p0[0], p0[1]);   await wait(300, token);
        pressDown();
        state.n++;
        save();
        await wait(DELAY, token);
    }

    async function loop() {
        const token = ++runToken;
        state.running = true;
        try {
            while (state.running && token === runToken) await cycle(token);
        } catch (e) {
            if (!(e instanceof Stopped)) { console.error(e); setStatus('Lỗi: ' + e.message); }
        }
    }

    function stop() { state.running = false; runToken++; save(); }

    $('#tm-play').onclick = () => { if (!state.running) { setStatus('Đang chạy…'); loop(); } };
    $('#tm-pause').onclick = () => { stop(); setStatus(`Tạm dừng (n tiếp theo = ${state.n})`); };
    $('#tm-copy').onclick = () => {
        const tsv = state.data.map(r =>
            [r.a, r.b].map(v => '"' + String(v).replace(/"/g, '""') + '"').join('\t')).join('\n');
        GM_setClipboard(tsv);
        setStatus('Đã copy bảng (TSV)');
    };
    $('#tm-reset').onclick = () => {
        if (!confirm('Xoá toàn bộ dữ liệu và đặt n = 1?')) return;
        stop(); state.n = 1; state.data = []; save(); render(); setStatus('Đã reset');
    };

    render();
    setStatus(`Sẵn sàng (n = ${state.n})`);
})();
